<!-- 离线校验 FastReport .frx 的最小项目模板（已实测可用）。
     关键点：TargetFramework 可低于后端，但 FastReport 包版本必须与后端一致，
     否则 deps.json 里的传递依赖会错配，启动时报 System.Drawing.Common 找不到。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FrxCheck</AssemblyName>
    <RootNamespace>FrxCheck</RootNamespace>
    <NoWarn>CS0168;CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FastReport.Core" Version="2022.3.15" />
  </ItemGroup>
</Project>
